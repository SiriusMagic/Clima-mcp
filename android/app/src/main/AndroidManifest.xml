<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The weather from Open-Meteo (its two fixed addresses) and Modo MCP through the relay when the user turns it on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- «Mi ubicación»: only the approximate position, only after the user allows it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <!-- «Redireccionar a Hub»: only apps signed with the same key (Gateway Hub) get this permission. -->
    <permission android:name="com.zirakusa.gatewayhub.permission.LINK" android:protectionLevel="signature"
        android:label="@string/hub_link_permission" />
    <!-- The family summary («Hoy» in Inicio): only apps signed with the same key may read it. -->
    <permission android:name="com.zirakusa.family.permission.SUMMARY" android:protectionLevel="signature"
        android:label="@string/summary_permission" />
    <!-- «Ir al Hub» opens the Gateway Hub app, when it is installed. -->
    <queries><package android:name="com.zirakusa.gatewayhub" /></queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <!-- Gateway Hub's scanner finds Clima (module weather_) and its link channel. Being found turns nothing on. -->
            <intent-filter>
                <action android:name="com.zirakusa.gatewayhub.action.APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.zirakusa.gatewayhub.module" android:value="weather_" />
            <meta-data android:name="com.zirakusa.gatewayhub.link" android:value="${applicationId}.hublink" />
            <meta-data android:name="com.zirakusa.family.summary" android:value="${applicationId}.summary" />
        </activity>
        <!-- The launcher icon the user picks in Ajustes (one alias enabled at a time). Never rename an alias: Android keeps
             the enabled state by name, and a renamed one could leave the app without an icon after an update. -->
        <activity-alias android:name=".Home" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="true" android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".HomeClaro" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_sun">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".HomeDorado" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_sunset">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".HomeAzul" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_rain">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".HomeVerde" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_storm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".HomeLuna" android:targetActivity=".MainActivity" android:exported="true"
            android:enabled="false" android:icon="@mipmap/ic_launcher_moon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <provider android:name=".SummaryProvider" android:authorities="${applicationId}.summary"
            android:exported="true" android:permission="com.zirakusa.family.permission.SUMMARY" />
        <provider android:name=".mcp.HubLinkProvider" android:authorities="${applicationId}.hublink"
            android:exported="true" android:permission="com.zirakusa.gatewayhub.permission.LINK" />
    </application>
</manifest>
